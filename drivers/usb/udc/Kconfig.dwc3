config UDC_DWC3
	bool "Synopsys USB device controller driver"
	default y
	select NOCACHE_MEMORY if ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select UDC_BUF_FORCE_NOCACHE
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT
	select UDC_DRIVER_HAS_SUPER_SPEED_SUPPORT
	depends on DT_HAS_SNPS_DWC3_ENABLED
	help
	  Synopsys DWC3 USB device controller driver.

if UDC_DWC3

config UDC_DWC3_EVENTS_NUM
	int "Number of events in the event ring buffer"
	default 16
	help
	  It is typically not needed to increase the number of events, but
	  if it were to happen due to some rare condition, increasing this
	  number could be useful.

config UDC_DWC3_TRB_NUM
	int "Number of buffers for each non-control endpoint"
	default 8
	range 3 32
	help
	  This is a general knob for the number of buffers present for each
	  endpoint. This does not affect control endpoints. The default is
	  enough for most conditions, but for performance and debug purposes,
	  increasing could reveal useful.

config UDC_DWC3_THREAD_STACK_SIZE
	int "DWC3 event thread stack size"
	default 2048
	help
	  Stack size for the bottom-half thread that drains the DWC3 event
	  ring. Event handling must run in thread context because helpers
	  such as udc_setup_received() take the UDC mutex.

config UDC_DWC3_THREAD_PRIORITY
	int "DWC3 event thread priority"
	default 2
	help
	  Cooperative priority for the DWC3 event thread. Keep this high so
	  control transfers (e.g. large configuration descriptors) are not
	  delayed by the system workqueue.

config UDC_DWC3_RTL_DOORBELL
	bool "RTL UsbMgr writes video TRBs and rings DEPCMD"
	default y
	help
	  When y, Soft-IP TRBRamSink owns the video TRB ring and doorbell
	  (P0 / dual-IMX219). When n, the CPU owns every TRB and DEPCMD
	  (IEBM / Lattice-ref model): pause_doorbell, hw_owned refuse, and
	  HW_IN_EP_MASK event masking are compiled out.

config UDC_DWC3_TXFIFO_VIDEO_EP5
	bool "TX FIFO map with video last (ACM0, RAW, UVC on 0x85)"
	default VIDEO_TINYVISION_UVCMANAGER_IEBM
	help
	  app_flir enumerates ACM0, CDC-RAW, then UVC, so video lands on
	  FIFO5 and needs the 1024-word (8 KiB) slot there. The other map is
	  the dual-UVC product one (video on FIFO3/4), which leaves FIFO5 at
	  64 words -- too small to start SuperSpeed bulk at MPS 1024, so the
	  video endpoint accepts StartXfer but its TRB stays HWO forever.
	  This tracks the endpoint layout, not IEBM vs doorbell; it only
	  defaults off IEBM because that was the sole app_flir build.

config UDC_DWC3_EVENT_BACKSTOP
	bool "2 ms event-thread timeout backstop"
	help
	  Finite k_sem_take timeout so a lost ISR wakeup still drains the
	  event ring. 100 ms until ConnectDone, then 2 ms so ACM does not
	  park for a full host timeout window. Do not disable.

config UDC_DWC3_HW_IN_EP_MASK
	hex "IN endpoints offloaded to the RTL video path"
	default 0x0
	depends on UDC_DWC3_RTL_DOORBELL
	help
	  Bitmask of IN endpoint indices whose TRBs the RTL (uvcmanager) drives.
	  Software must ignore XferComplete/XferInProgress on those endpoints:
	  bit 5 means endpoint 0x85.  Without this, the Soft-IP driver pops
	  phantom buffers from the ring and races the hardware stream.

config UDC_DWC3_SKIP_GCTL_SOFTRESET
	bool "Skip GCTL/PHY soft-reset (TinyCLUNX Lattice USB23)"
	default y
	help
	  On TinyCLUNX Soft-IP, GCTL.CORESOFTRESET / PHYSOFTRST make
	  GHWPARAMS7 read 0 and SuperSpeed enum dies. Skip both and rely
	  on DCTL.CSFTRST. Some doorbell bitstreams need the documented
	  GCTL/PHY reset or EP0 DEPCMD never completes — turn this off.

config UDC_DWC3_CDC_TRACE
	bool "Periodic CDC endpoint state trace on the console"
	depends on UDC_DWC3_HW_IN_EP_MASK != 0x0
	help
	  Print a CDC-TRACE line for every CPU-managed endpoint whose ring
	  state has not changed for a while. Debug aid only: the print runs
	  in the DWC3 event thread and blocks on the console UART, so keep it
	  off in soak/production builds.

config UDC_DWC3_IN_RECOVER_EP_MASK
	hex "IN endpoint indices eligible for Soft-IP IN recovery"
	default 0x10
	help
	  Bitmask of IN endpoint indices the completion-poll / park paths may
	  touch.  With ACM at 0x81/0x82 and CDC-RAW bulk IN at 0x84, bit 4
	  selects RAW.  Do not include ACM endpoints: those sit armed waiting
	  for a host token and EndXfer recycle breaks the bulk command path.
	  Never include HW_IN bits (see UDC_DWC3_HW_IN_EP_MASK).

config UDC_DWC3_IN_COMPLETION_POLL
	bool "Poll for dropped IN completions"
	help
	  Under concurrent UVC + CDC bulk, this Soft-IP controller sometimes
	  clears HWO on a CPU-managed IN TRB without posting a DEPEVT.  The
	  event thread then never retires the buffer and the class stops
	  enqueueing.  When enabled, each event-thread wake (including the
	  100 ms lost-wakeup timeout) reclaims waiting slots whose HWO has
	  been clear for a grace interval.  Limited to
	  UDC_DWC3_IN_RECOVER_EP_MASK.

config UDC_DWC3_OUT_COMPLETION_POLL
	bool "Poll for dropped OUT completions"
	help
	  Mirror of UDC_DWC3_IN_COMPLETION_POLL for CPU-managed bulk OUT.
	  Under Soft-IP isochronous UVC the controller clears HWO on a CDC OUT
	  TRB without posting a DEPEVT, so the received packet is never handed
	  to the class.  The slot is only retired when the next OUT completes,
	  which leaves the pipe permanently one transfer behind: the host times
	  out waiting for its reply and then receives the previous one.  When
	  enabled, each event-thread wake retires waiting OUT slots whose HWO
	  has been clear for a grace interval.

config UDC_DWC3_OUT_COMPLETION_POLL_TICKS
	int "Grace event-thread wakes before retiring an OUT completion"
	default 8
	depends on UDC_DWC3_OUT_COMPLETION_POLL
	help
	  Wakes of the 100 ms event-thread timeout that HWO must stay clear
	  before a software retire.  Too short races a live DEPEVT and desyncs
	  the ring, which is the same trade-off tuned for the IN poll.

config UDC_DWC3_IN_PARK_RECOVER
	bool "Recover an IN endpoint whose armed TRB is never fetched"
	help
	  Re-arm a CPU-managed IN endpoint whose tail TRB stays owned by
	  hardware with no remaining-count progress for longer than
	  UDC_DWC3_IN_PARK_RECOVER_MS.  That is the signature of a dropped
	  UpdateXfer doorbell under UVC load (CDC-RAW IN 0x84).  Limited to
	  UDC_DWC3_IN_RECOVER_EP_MASK so quiet ACM pipes are not recycled.

config UDC_DWC3_IN_PARK_RECOVER_MS
	int "Time an IN TRB may stay unfetched before re-arming (ms)"
	default 100
	depends on UDC_DWC3_IN_PARK_RECOVER
	help
	  Keep this below the host bulk-read stall timeout and long enough
	  that a quiet host poll of ACM/CDC-RAW does not look like a park.

config UDC_DWC3_IN_START_ENDXFER_ESCALATE
	bool "Escalate parked IN with EndXfer(ForceRM)+StartXfer"
	depends on UDC_DWC3_IN_PARK_RECOVER
	default y
	help
	  After a few failed UpdateXfer nudges, tear the transfer resource
	  and re-Start the same still-owned tail TRB.  Ring head/tail are
	  left intact so the class completion path stays in sync.  Do not
	  use the ordinary DepEndXfer helper (it zeroes the ring).

config UDC_DWC3_OUT_NOTREADY_RETAKE
	bool "Retake bulk OUT on XferNotReady (armed TRB ignored)"
	help
	  Enable XferNotReady events on bulk OUT endpoints.  When one arrives
	  while the tail TRB is armed and HWO, the StartXfer doorbell was
	  dropped: EndXfer(ForceRM)+StartXfer retakes the resource without
	  clearing the ring.  Without this, host Write timeout on ACM OUT
	  under UVC can wedge the host xHCI controller.

config UDC_DWC3_OUT_STALL_REFRESH
	bool "Refresh/retake a stalled bulk OUT (timer backstop)"
	depends on UDC_DWC3_OUT_NOTREADY_RETAKE
	help
	  Soft-IP often never posts XferNotReady for a wedged ACM OUT.  Every
	  UDC_DWC3_OUT_STALL_REFRESH_MS, UpdateXfer the armed OUT tail; after a
	  few no-progress refreshes, EndXfer(ForceRM)+StartXfer.  UpdateXfer is
	  a no-op on a healthy idle OUT; recycle only runs after the pipe has
	  been stuck for multiple intervals (same trade-off as dual soak).

config UDC_DWC3_OUT_STALL_REFRESH_MS
	int "OUT stall observation window (ms)"
	default 250
	depends on UDC_DWC3_OUT_STALL_REFRESH

config UDC_DWC3_DEPCMD_MAILBOX
	bool "Post DEPCMD through the RTL mailbox (single writer)"
	depends on UDC_DWC3_RTL_DOORBELL
	help
	  CPU writes MBX_ADDR/MBX_DATA at 0xb4008000. Soft-IP DepCmdArbiter
	  is the only LMMI writer of DWC3 DEPCMD: it ORs CMDACT, waits for
	  clear, and returns the retired word (XFERRSCIDX). pause_doorbell
	  is unused. Requires the doorbell bitstream with DepCmdArbiter.
	  Leave n on IEBM bits (CPU writes DEPCMD directly).

config UDC_DWC3_QUIET_OTHER_CYCLES
	int "DepCmd QUIET_OTHER video hold (75 MHz cycles)"
	default 60000
	depends on UDC_DWC3_DEPCMD_MAILBOX
	help
	  Written to DepCmdArbiter QUIET_OTHER (0xb4008038) at UDC init.
	  After each non-StartXfer CPU DEPCMD, video DEPCMD is held for this
	  many spinex cycles. RTL reset is 60000 (800 us @ 75 MHz). 7500 is
	  100 us. 0 disables the hold. StartXfer quiet (cpuQuiet / trbFetch)
	  is unchanged.

config UDC_DWC3_USB_ENGINE
	bool "Post ACM/RAW through UsbEngine BulkRing"
	depends on UDC_DWC3_DEPCMD_MAILBOX
	help
	  After ENG_CTRL.ENABLE, RTL owns GEVNTCOUNT and ACM/RAW DEPCMD.
	  CPU posts DESC_* and drains FWD_POP / CMPL_*. Video stays on the
	  doorbell. Leave n to keep CPU mailbox ownership (QUIET_OTHER).
	  Probe MAGIC 0x5533 at 0xb400B000 before enabling.

endif # UDC_DWC3
